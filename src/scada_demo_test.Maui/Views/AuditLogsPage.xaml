<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:scada_demo_test.Maui.ViewModels"
             xmlns:entities="clr-namespace:scada_demo_test.Domain.Entities;assembly=scada_demo_test.Domain"
             x:Class="scada_demo_test.Maui.Views.AuditLogsPage"
             x:DataType="vm:AuditLogsViewModel"
             Title="Audit Logs"
             BackgroundColor="{StaticResource ScadaBgDark}">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadLogsCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- Header Section -->
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Audit Trail &amp; Access Log" Style="{StaticResource ScadaPageTitle}" />
                        <Label Text="Compliance, permission adjustments &amp; operator actions" Style="{StaticResource ScadaPageSubtitle}" />
                    </VerticalStackLayout>

                    <Border Grid.Column="1"
                            StrokeShape="RoundRectangle 8"
                            Stroke="{StaticResource ScadaBorder}"
                            BackgroundColor="{StaticResource ScadaBgSurface}"
                            Padding="12,6"
                            VerticalOptions="Center">
                        <Label Text="{Binding TotalLogsCount, StringFormat='{0} Entries'}"
                               TextColor="{StaticResource ScadaCyan}"
                               FontSize="12"
                               FontAttributes="Bold" />
                    </Border>
                </Grid>

                <!-- Search Input Bar -->
                <Border StrokeShape="RoundRectangle 8"
                        Stroke="{StaticResource ScadaBorder}"
                        BackgroundColor="{StaticResource ScadaBgSurface}"
                        Padding="12,2">
                    <Grid ColumnDefinitions="Auto, *">
                        <Label Grid.Column="0" Text="🔍" FontSize="14" VerticalOptions="Center" Margin="0,0,8,0" />
                        <Entry Grid.Column="1"
                               Text="{Binding SearchText}"
                               Placeholder="Filter audit trail by action, user or details..."
                               PlaceholderColor="{StaticResource ScadaTextDim}"
                               TextColor="{StaticResource ScadaTextPrimary}"
                               ClearButtonVisibility="WhileEditing" />
                    </Grid>
                </Border>

                <!-- Audit Logs Collection -->
                <CollectionView ItemsSource="{Binding Logs}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="40" Spacing="8" HorizontalOptions="Center">
                            <Label Text="📋" FontSize="36" HorizontalTextAlignment="Center" />
                            <Label Text="No audit logs match current filter." TextColor="{StaticResource ScadaTextMuted}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="entities:AuditLog">
                            <Border Margin="0,0,0,10"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="{StaticResource ScadaBorder}"
                                    BackgroundColor="{StaticResource ScadaBgSurface}"
                                    Padding="14">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 6"
                                                BackgroundColor="{StaticResource ScadaBgCard}"
                                                Padding="8,4"
                                                HorizontalOptions="Start">
                                            <Label Text="{Binding Action}"
                                                   TextColor="{StaticResource ScadaCyan}"
                                                   FontSize="12"
                                                   FontAttributes="Bold" />
                                        </Border>

                                        <Label Grid.Column="1"
                                               Text="{Binding Timestamp, StringFormat='{0:MMM dd, HH:mm}'}"
                                               TextColor="{StaticResource ScadaTextDim}"
                                               FontSize="11"
                                               VerticalOptions="Center" />
                                    </Grid>

                                    <Label Text="{Binding Details}"
                                           TextColor="{StaticResource ScadaTextPrimary}"
                                           FontSize="13"
                                           LineBreakMode="WordWrap" />

                                    <Grid ColumnDefinitions="*, Auto">
                                        <HorizontalStackLayout Grid.Column="0" Spacing="4">
                                            <Label Text="👤" FontSize="11" VerticalOptions="Center" />
                                            <Label Text="{Binding UserName, FallbackValue='System'}" TextColor="{StaticResource ScadaTextSecondary}" FontSize="11" />
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                            <Label Text="🌐" FontSize="11" VerticalOptions="Center" />
                                            <Label Text="{Binding IpAddress, FallbackValue='127.0.0.1'}" TextColor="{StaticResource ScadaTextDim}" FontSize="11" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
