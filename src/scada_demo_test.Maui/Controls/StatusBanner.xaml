<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="scada_demo_test.Maui.Controls.StatusBanner">

    <Border StrokeShape="RoundRectangle 8"
            Stroke="#374151"
            StrokeThickness="1"
            BackgroundColor="#111827"
            Padding="12,10"
            Margin="0,0,0,12">
        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
            <!-- Pulsing Status Dot -->
            <BoxView Grid.Column="0"
                     x:Name="DotIndicator"
                     WidthRequest="10"
                     HeightRequest="10"
                     CornerRadius="5"
                     Color="#10B981"
                     VerticalOptions="Center" />

            <!-- Status Description -->
            <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                <Label x:Name="StatusLabel"
                       Text="System Telemetry: Online (Live Stream)"
                       TextColor="#F9FAFB"
                       FontSize="13"
                       FontAttributes="Bold" />
                <Label x:Name="SubtitleLabel"
                       Text="Modbus RTU / TCP Gateway active"
                       TextColor="#9CA3AF"
                       FontSize="11" />
            </StackLayout>

            <!-- Mode Badge -->
            <Border Grid.Column="2"
                    x:Name="BadgeBorder"
                    StrokeShape="RoundRectangle 4"
                    BackgroundColor="#1F2937"
                    Stroke="#4B5563"
                    StrokeThickness="1"
                    Padding="6,3"
                    VerticalOptions="Center">
                <Label x:Name="BadgeLabel"
                       Text="SIMULATION"
                       TextColor="#06B6D4"
                       FontSize="10"
                       FontAttributes="Bold" />
            </Border>
        </Grid>
    </Border>
</ContentView>
