@page "/login"
@layout scada_demo_test.Web.Shared.LoginLayout

<div class="login-shell">
    <div class="login-card">
        <div class="login-brand">
            <img class="brand-mark brand-logo" src="/images/logo.jpg" alt="ALAM IOT logo" />
            <h2>ALAM IOT Enterprises</h2>
            <p>INDUSTRIAL UTILITY &amp; TELEMETRY PLATFORM</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="login-error-banner" role="alert">
                <svg class="error-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span>@Error</span>
            </div>
        }

        <form class="login-form" method="post" action="/account/login">
            <div class="form-group">
                <label for="email">Email Address</label>
                <input id="email" class="custom-input" type="email" name="email" value="superadmin@alamiot.com" placeholder="name@alamiot.com" required autofocus />
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <div class="password-input-wrapper">
                    <input id="password" class="custom-input" type="@(ShowPassword ? "text" : "password")" name="password" value="SuperAdmin@123" placeholder="Enter your password" required />
                    <button type="button" class="btn-eye-toggle" @onclick="() => ShowPassword = !ShowPassword"
                            aria-label="@(ShowPassword ? "Hide password" : "Show password")"
                            title="@(ShowPassword ? "Hide password" : "Show password")">
                        @if (ShowPassword)
                        {
                            <svg class="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"></path>
                                <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        }
                        else
                        {
                            <svg class="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        }
                    </button>
                </div>
            </div>

            <div class="form-row-between">
                <label class="remember-row">
                    <input type="checkbox" name="rememberMe" checked />
                    <span>Keep me signed in (30 days)</span>
                </label>
            </div>

            <button class="btn-login" type="submit">
                <span>Sign In</span>
            </button>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    [Parameter]
    public string? Error { get; set; }

    private bool ShowPassword = false;
}
