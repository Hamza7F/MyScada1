@* ---- Delete Gateway Confirmation Modal ---- *@
@if (DeviceToDelete != null)
{
    <div class="modal-overlay" @onclick="() => DeviceToDelete = null">
        <div class="modal-card glass-card" style="min-width:440px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 style="color:#ef4444;">Delete Gateway Device</h3>
                <button class="modal-close" @onclick="() => DeviceToDelete = null">✕</button>
            </div>
            <div class="modal-body">
                <p style="color:var(--text-muted);font-size:0.9rem;">
                    Are you sure you want to delete gateway <strong style="color:var(--text-primary);">@DeviceToDelete.Name</strong> (<code>@DeviceToDelete.ExternalId</code>)?
                </p>
                <p style="color:var(--accent-rose);font-size:0.8rem;">
