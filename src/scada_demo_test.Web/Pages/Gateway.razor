    </div>
}

@code {
    private List<ScadaDemoTestApiClient.GatewayDeviceDto> GatewayDevices = new();
    private List<ScadaDemoTestApiClient.SensorLibraryDto> SensorLibraries = new();
    private bool Loading = true;

    private Guid? SelectedGatewayGuid;
    private ScadaDemoTestApiClient.GatewayDeviceDto? SelectedGateway => GatewayDevices.FirstOrDefault(d => d.Id == SelectedGatewayGuid);

    private ScadaDemoTestApiClient.GatewayDeviceDto? DeviceToDelete;
    private ScadaDemoTestApiClient.AttachedSensorDto? SensorToDelete;
    private bool DeleteBusy;

    private bool Scanning;
    private bool ScanFailed;
    private string ScanModeLabel = "";
    private ScadaDemoTestApiClient.GatewayScanResultDto? LastScan;
    private bool SelectAllFound;
    private readonly HashSet<int> ConfirmSelection = new();

    private sealed class PickedMeter
    {
        public required ScadaDemoTestApiClient.ScannedMeterDto Meter { get; init; }
        public string SensorName { get; set; } = "";
        public int SlaveAddress { get; set; }
        public int PollIntervalSeconds { get; set; } = 5;
        public double CalibrationMultiplier { get; set; } = 1.0;
        public HashSet<string> SelectedParams { get; set; } = new();
        public bool Added { get; set; }
        public bool IsTank { get; set; }
        public double TankCapacity { get; set; } = 1000;
        public string LiquidType { get; set; } = "Water";
    }

    private sealed record MeterParam(string Key, string Label, string Unit);

    // Meter parameter catalog per driver (mirrors ModbusMeterLibs settings):
    // keys map to telemetry columns unless noted; extra params are stored as
    // metadata on the sensor (MetricFields).
    private static readonly IReadOnlyDictionary<string, List<MeterParam>> ParamCatalog =
        new Dictionary<string, List<MeterParam>>(StringComparer.OrdinalIgnoreCase)
        {
            ["AOSONG_AQ3485"] = new()
            {
                new("TemperatureC", "Temperature", "°C"),
                new("HumidityRH", "Humidity", "%RH"),
            },
            ["KAIFENG_FLOWMETER"] = new()
            {
                new("InstantaneousFlowRate", "Flow Rate", "Nm³/h"),
                new("AccumulatedTotalizer", "Totalizer", "Nm³"),
                new("Velocity", "Velocity (metadata only)", "m/s"),
            },
            ["KAIFENG_EM_FLOWMETER"] = new()
            {
                new("InstantaneousFlowRate", "Flow Rate", "m³/h"),
                new("AccumulatedTotalizer", "Totalizer", "m³"),
            },
            ["VORTEX_FLOWMETER"] = new()
            {
                new("InstantaneousFlowRate", "Flow Rate", "m³/h"),
                new("AccumulatedTotalizer", "Totalizer", "m³"),
            },
            ["SELEC_POWER_METER"] = new()
            {
                new("InstantaneousFlowRate", "Power", "kW"),
                new("AccumulatedTotalizer", "Energy", "kWh"),
            },
        };

    private List<PickedMeter> PickedMeters = new();
    private PickedMeter? Configuring;
    private string? ConfigSlaveMessage;
    private string? ConfigFormError;

    private sealed class SensorEditState
    {
        public Guid SensorId;
        public string SensorName = "";
        public int PollIntervalSeconds;
        public double CalibrationMultiplier;
        public string UniqueSensorId = "";
        public string DriverKey = "";
        public string SlaveText = "";
        public HashSet<string> SelectedParams = new();
        public bool IsTank;
        public double TankCapacity = 1000;
        public string LiquidType = "Water";
    }

    private SensorEditState? EditingSensor;
    private bool EditBusy;
    private string? EditFormError;

    private bool ConfigSubmitBusy;

    private List<ScadaDemoTestApiClient.AttachedSensorDto>? ChildrenSensors = new();

    private Dictionary<Guid, List<ScadaDemoTestApiClient.AttachedSensorDto>> AllChildren = new();

    private string? ToastMessage;
    private bool ToastIsError;

    private bool ShowDeviceModal;
    private string NewDeviceName = "";
    private string NewDeviceHardware = "USR-W610";
    private string NewDeviceIp = "";
    private int NewDevicePort = 502;
    private int NewDeviceBaud = 9600;
    private string NewDeviceParityStop = "None";
    private int NewDeviceTimeout = 2000;
    private string? DeviceFormError;
    private string? DeviceIpMessage;
    private string? DeviceFormSuccess;
    private bool DeviceSubmitBusy;

    private System.Threading.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadGatewaysAsync();
        SensorLibraries = await Api.GetSensorLibrariesAsync();

        // 4-second live refresh: gateway status + children of the selected gateway.
        _timer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadGatewaysAsync();
                if (SelectedGatewayGuid is Guid gid)
                {
                    await RefreshChildrenAsync(gid);
                }
                StateHasChanged();
            });
        }, null, 1000, 4000);
    }

    private async Task LoadGatewaysAsync()
    {
        try
        {
            GatewayDevices = (await Api.GetGatewayDevicesAsync()).OrderBy(d => d.CreatedAt ?? DateTime.MaxValue).ThenBy(d => d.Id).ToList();
            var all = await Api.GetSensorsAsync();
            AllChildren = all.GroupBy(s => s.DeviceId).ToDictionary(g => g.Key, g => g.ToList());
        }
        catch { await ToastAsync("Failed to load gateways", true); }
        Loading = false;
    }

    private async Task SelectGateway(ScadaDemoTestApiClient.GatewayDeviceDto d)
    {
        if (SelectedGatewayGuid == d.Id)
        {
            SelectedGatewayGuid = null;
            PickedMeters.Clear();
            ChildrenSensors = new();
            LastScan = null;
            ConfirmSelection.Clear();
            return;
        }
        SelectedGatewayGuid = d.Id;
        LastScan = null;
        ScanFailed = false;
        ConfirmSelection.Clear();
        PickedMeters.Clear();
        await RefreshChildrenAsync(d.Id);
        StateHasChanged();
    }

    private async Task RefreshChildrenAsync(Guid deviceId)
    {
        try
        {
            ChildrenSensors = await Api.GetSensorsAsync(deviceId);
            AllChildren[deviceId] = ChildrenSensors ?? new();
        }
        catch { ChildrenSensors = new(); }
    }

    private void PromptDeleteDevice(ScadaDemoTestApiClient.GatewayDeviceDto d)
    {
        DeviceToDelete = d;
    }

    private async Task ConfirmDeleteDeviceAsync()
    {
        if (DeviceToDelete == null || DeleteBusy) return;
        DeleteBusy = true;
        var name = DeviceToDelete.Name;
        var id = DeviceToDelete.Id;
        var (ok, err) = await Api.DeleteGatewayDeviceAsync(id);
        DeleteBusy = false;
        DeviceToDelete = null;
        if (!ok)
        {
            await ToastAsync(err ?? "Failed to delete gateway.", true);
            return;
        }
        if (SelectedGatewayGuid == id)
        {
            SelectedGatewayGuid = null;
            PickedMeters.Clear();
            ChildrenSensors = new();
            LastScan = null;
            ConfirmSelection.Clear();
        }
        await LoadGatewaysAsync();
        await ToastAsync($"Gateway '{name}' and its telemetry tables deleted.", false);
    }

    private void PromptDeleteSensor(ScadaDemoTestApiClient.AttachedSensorDto s)
    {
        SensorToDelete = s;
    }

    private async Task ConfirmDeleteSensorAsync()
    {
        if (SensorToDelete == null || DeleteBusy) return;
        DeleteBusy = true;
        var name = SensorToDelete.Name;
        var sensorId = SensorToDelete.Id;
        var owner = SensorToDelete.DeviceId;
        var (ok, err) = await Api.DeleteSensorAsync(sensorId);
        DeleteBusy = false;
        SensorToDelete = null;
        if (!ok)
        {
            await ToastAsync(err ?? "Failed to delete sensor.", true);
            return;
        }
        ChildrenSensors?.RemoveAll(s => s.Id == sensorId);
        if (AllChildren.TryGetValue(owner, out var ownerList)) ownerList.RemoveAll(s => s.Id == sensorId);
        if (SelectedGatewayGuid is Guid gid2) await RefreshChildrenAsync(gid2);
        await ToastAsync($"Sensor '{name}' and its telemetry table deleted.", false);
    }

    private async Task ScanFromCard(ScadaDemoTestApiClient.GatewayDeviceDto d)
    {
        if (Scanning) return;
        if (SelectedGatewayGuid != d.Id)
        {
            await SelectGateway(d);
        }
        await FindSensorsAsync(passes: 0, deepDuplicateCheck: true, "Full 1-247");
    }

    private async Task FindSensorsAsync(int passes, bool deepDuplicateCheck, string modeLabel)
    {
        if (Scanning || SelectedGatewayGuid is not Guid gid) return;
        Scanning = true;
        ScanFailed = false;
        ScanModeLabel = modeLabel;
        ConfirmSelection.Clear();

        try
        {
            var result = await Api.ScanGatewayBusAsync(gid, probeTimeoutMs: 200, passes: passes, deepDuplicateCheck: deepDuplicateCheck);
            if (result is null || !result.ConnectivityOk)
            {
                ScanFailed = true;
            }
            if (result is not null)
            {
                result = result with
                {
                    Found = result.Found ?? new(),
                    SkippedSlaves = result.SkippedSlaves ?? new(),
                    AmbiguousSlaves = result.AmbiguousSlaves ?? new(),
                    DuplicateIdConflicts = result.DuplicateIdConflicts ?? new(),
                };
                LastScan = result;
                SelectAllFound = false;
            }
        }
        catch
        {
            ScanFailed = true;
        }
        finally
        {
            Scanning = false;
        }

        StateHasChanged();
    }

    private void QuickScanAsync() { _ = FindSensorsAsync(passes: 1, deepDuplicateCheck: false, "Quick 1-20"); }
    private void FullScanAsync() { _ = FindSensorsAsync(passes: 0, deepDuplicateCheck: true, "Full 1-247"); }

    private void ToggleOne(int slave)
    {
        if (!ConfirmSelection.Remove(slave))
        {
            ConfirmSelection.Add(slave);
        }
        var found = LastScan?.Found ?? new();
        SelectAllFound = found.Count > 0 && found.All(m => ConfirmSelection.Contains(m.SlaveAddress));
    }

    private void ToggleSelectAll()
    {
        if (LastScan == null) return;
        ConfirmSelection.Clear();
        if (SelectAllFound)
        {
            foreach (var m in LastScan.Found.Where(m => m.Status == "identified"))
            {
                ConfirmSelection.Add(m.SlaveAddress);
            }
        }
    }

    private void ClearScan()
    {
        LastScan = null;
        ScanFailed = false;
        ConfirmSelection.Clear();
        SelectAllFound = false;
    }

    private async Task StartAddFlow()
    {
        if (LastScan == null) return;

        foreach (var m in LastScan.Found.Where(m => ConfirmSelection.Contains(m.SlaveAddress) && m.Status == "identified"))
        {
            if (PickedMeters.Any(p => p.Meter.SlaveAddress == m.SlaveAddress)) continue;

            var defaults = ParamCatalog.TryGetValue(m.DriverKey ?? "", out var list) ? list : new List<MeterParam>();
            PickedMeters.Add(new PickedMeter
            {
                Meter = m,
                SensorName = m.SuggestedName,
                SlaveAddress = m.SlaveAddress,
                PollIntervalSeconds = m.DefaultPollIntervalSeconds > 0 ? m.DefaultPollIntervalSeconds : 5,
                SelectedParams = new HashSet<string>(defaults.Select(p => p.Key)),
            });
        }

        if (PickedMeters.Count > 0)
        {
            await ToastAsync($"{PickedMeters.Count} meter(s) selected — configure parameters for each one.", false);
            OpenNextConfigure();
        }
        StateHasChanged();
    }

    private void OpenNextConfigure()
    {
        var next = PickedMeters.FirstOrDefault(p => !p.Added);
        if (next != null)
        {
            ConfigureMeter(next);
        }
    }

    private void ConfigureMeter(PickedMeter p)
    {
        ConfigSlaveMessage = null;
        ConfigFormError = null;
        Configuring = p;
        OnConfigSlaveChanged();
    }

    private static List<MeterParam> ParamsFor(ScadaDemoTestApiClient.ScannedMeterDto m) =>
        ParamCatalog.TryGetValue(m.DriverKey ?? "", out var list) ? list : new List<MeterParam>();

    private void ToggleParam(string key, bool value)
    {
        if (Configuring == null) return;
        if (value) Configuring.SelectedParams.Add(key);
        else Configuring.SelectedParams.Remove(key);
    }

    private static List<MeterParam> ParamsForDriver(string driverKey) =>
        ParamCatalog.TryGetValue(driverKey, out var list) ? list : new List<MeterParam>();

    private void ToggleAllParams(bool on)
    {
        if (Configuring == null) return;
        Configuring.SelectedParams.Clear();
        if (on)
        {
            foreach (var p in ParamsFor(Configuring.Meter))
            {
                Configuring.SelectedParams.Add(p.Key);
            }
        }
    }

    private void ToggleAllEditParams(bool on)
    {
        if (EditingSensor == null) return;
        EditingSensor.SelectedParams.Clear();
        if (on)
        {
            foreach (var p in ParamsForDriver(EditingSensor.DriverKey))
            {
                EditingSensor.SelectedParams.Add(p.Key);
            }
        }
    }

    private void ToggleEditParam(string key, bool value)
    {
        if (EditingSensor == null) return;
        if (value) EditingSensor.SelectedParams.Add(key);
        else EditingSensor.SelectedParams.Remove(key);
    }

    private static Dictionary<string, string> ParseMetricFields(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return new();
        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(json) ?? new();
        }
        catch { return new(); }
    }

    // Drivers that report a volume totalizer -> the only ones that can back a tank.
    private static readonly HashSet<string> TankCapableDrivers =
        new(StringComparer.OrdinalIgnoreCase) { "KAIFENG_FLOWMETER", "KAIFENG_EM_FLOWMETER", "VORTEX_FLOWMETER" };

    private static bool HasTankSupport(string driverKey) =>
        TankCapableDrivers.Contains(driverKey);

    // Sensor.Config JSON persisted by the API. Only a sensor flagged as a tank
    // becomes a tank on the Storage Tanks page (thousands of other sensors stay
    // plain meters).
    private sealed class SensorConfigDto
    {
        public bool IsTank { get; set; }
        public double Capacity { get; set; }
        public string? LiquidType { get; set; }
    }

    private static SensorConfigDto ParseSensorConfig(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return new();
        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<SensorConfigDto>(json) ?? new();
        }
        catch { return new(); }
    }

    private static string? BuildTankConfig(bool isTank, double capacity, string liquidType)
    {
        if (!isTank) return null;
        var cfg = new Dictionary<string, object>
        {
            ["isTank"] = true,
            ["capacity"] = capacity > 0 ? capacity : 1000,
            ["liquidType"] = string.IsNullOrWhiteSpace(liquidType) ? "Water" : liquidType.Trim(),
            ["levelSource"] = "AccumulatedTotalizer"
        };
        return System.Text.Json.JsonSerializer.Serialize(cfg);
    }

    private void OpenEditSensor(ScadaDemoTestApiClient.AttachedSensorDto s)
    {
        EditFormError = null;
        var current = ParseMetricFields(s.MetricFields);
        var tank = ParseSensorConfig(s.Config);
        EditingSensor = new SensorEditState
        {
            SensorId = s.Id,
            SensorName = s.Name,
            PollIntervalSeconds = s.PollIntervalSeconds,
            CalibrationMultiplier = s.CalibrationMultiplier,
            UniqueSensorId = s.UniqueSensorId,
            DriverKey = s.SensorTypeKey,
            SlaveText = $"{s.SlaveAddress} (0x{s.SlaveAddress:X2})",
            SelectedParams = new HashSet<string>(current.Keys),
            IsTank = tank.IsTank,
            TankCapacity = tank.Capacity > 0 ? tank.Capacity : 1000,
            LiquidType = string.IsNullOrWhiteSpace(tank.LiquidType) ? "Water" : tank.LiquidType
        };
    }

    private async Task SaveEditsAsync()
    {
        if (EditingSensor == null || EditBusy) return;
        if (EditingSensor.SelectedParams.Count == 0)
        {
            EditFormError = "Select at least one parameter for this sensor.";
            return;
        }

        EditBusy = true;
        EditFormError = null;

        var selectedParams = new Dictionary<string, string>();
        foreach (var p in ParamsForDriver(EditingSensor.DriverKey))
        {
            if (EditingSensor.SelectedParams.Contains(p.Key))
            {
                selectedParams[p.Key] = p.Unit;
            }
        }

        // "" (empty string) explicitly CLEARS the tank flag when the operator
        // unchecks "Storage Tank asset" (the API only replaces Config when non-null).
        var config = EditingSensor.IsTank
            ? BuildTankConfig(true, EditingSensor.TankCapacity, EditingSensor.LiquidType)
            : "";

        var req = new ScadaDemoTestApiClient.UpdateSensorRequest(
            EditingSensor.SensorName.Trim(),
            EditingSensor.PollIntervalSeconds,
            EditingSensor.CalibrationMultiplier,
            selectedParams.Count > 0 ? selectedParams : null,
            config);

        var (ok, _, err) = await Api.UpdateSensorAsync(EditingSensor.SensorId, req);
        EditBusy = false;

        if (!ok)
        {
            EditFormError = err ?? "Update failed.";
            return;
        }

        EditingSensor = null;
        if (SelectedGatewayGuid is Guid gid) await RefreshChildrenAsync(gid);
        await ToastAsync("Sensor parameters updated.", false);
        StateHasChanged();
    }

    private void OnConfigSlaveChanged()
    {
        ConfigSlaveMessage = null;
        if (Configuring == null) return;
        var addr = Configuring.SlaveAddress;
        if (addr < 1 || addr > 247)
        {
            ConfigSlaveMessage = "Modbus slave address must be between 1 and 247.";
            return;
        }

        var used = (ChildrenSensors ?? new()).Any(s => s.SlaveAddress == addr) ||
                   PickedMeters.Any(p => p != Configuring && !p.Added && p.SlaveAddress == addr);
        if (used)
        {
            ConfigSlaveMessage = $"Slave address {addr} is already used on this gateway — each meter needs a unique address.";
        }
    }

    private async Task AddMeterAsSensor()
    {
        if (Configuring == null || ConfigSubmitBusy) return;
        ConfigSubmitBusy = true;
        ConfigFormError = null;

        OnConfigSlaveChanged();
        if (ConfigSlaveMessage != null)
        {
            ConfigSubmitBusy = false;
            return;
        }

        var selectedParams = new Dictionary<string, string>();
        foreach (var p in ParamsFor(Configuring.Meter))
        {
            if (Configuring.SelectedParams.Contains(p.Key))
            {
                selectedParams[p.Key] = p.Unit;
            }
        }

        if (SelectedGatewayGuid is not Guid gid)
        {
            ConfigSubmitBusy = false;
            return;
        }

        var req = new ScadaDemoTestApiClient.CreateSensorRequest(
            gid,
            Configuring.SensorName.Trim(),
            Configuring.Meter.DriverKey ?? "",
            Configuring.SlaveAddress,
            Configuring.PollIntervalSeconds,
            Configuring.CalibrationMultiplier,
            selectedParams.Count > 0 ? selectedParams : null,
            BuildTankConfig(Configuring.IsTank, Configuring.TankCapacity, Configuring.LiquidType));

        var (ok, data, err) = await Api.CreateSensorAsync(req);
        ConfigSubmitBusy = false;

        if (!ok)
        {
            ConfigFormError = err ?? "Failed to create sensor.";
            return;
        }

        Configuring.Added = true;
        var addedName = Configuring.SensorName;
        Configuring = null;
        await RefreshChildrenAsync(gid);
        await LoadGatewaysAsync();
        await ToastAsync($"Sensor '{addedName}' added as a child of gateway '{SelectedGateway?.Name ?? ""}' -> Table: {data!.TelemetryTableName}", false);
        StateHasChanged();
        OpenNextConfigure();
    }

    private void OpenAddDeviceModal()
    {
        ShowDeviceModal = true;
        ToastMessage = null;
        NewDeviceName = "";
        NewDeviceHardware = "USR-W610";
        NewDeviceIp = "";
        NewDevicePort = 502;
        NewDeviceBaud = 9600;
        NewDeviceParityStop = "None";
        NewDeviceTimeout = 2000;
        DeviceFormError = null;
        DeviceIpMessage = null;
        DeviceFormSuccess = null;
        DeviceSubmitBusy = false;
    }

    private static string SanitizeIp(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return string.Empty;
        var s = raw.Trim();
        if (s.StartsWith("http://", StringComparison.OrdinalIgnoreCase)) s = s["http://".Length..];
        else if (s.StartsWith("https://", StringComparison.OrdinalIgnoreCase)) s = s["https://".Length..];
        var slashIdx = s.IndexOf('/');
        if (slashIdx >= 0) s = s[..slashIdx];
        var colonIdx = s.IndexOf(':');
        if (colonIdx >= 0 && !s.Contains("::")) s = s[..colonIdx];
        return s.Trim();
    }

    private void OnDeviceIpChanged()
    {
        DeviceFormError = null;
        DeviceIpMessage = null;
        NewDeviceIp = SanitizeIp(NewDeviceIp);
        var ip = NewDeviceIp;
        if (ip.Length == 0) return;
        var dup = GatewayDevices.FirstOrDefault(d =>
            string.Equals(SanitizeIp(d.IpAddress ?? ""), ip, StringComparison.OrdinalIgnoreCase));
        if (dup != null)
        {
            DeviceIpMessage = $"IP address '{ip}' is already registered to gateway '{dup.Name}' ({dup.ExternalId}).";
        }
    }

    private async Task SubmitDeviceAsync()
    {
        if (DeviceSubmitBusy) return;
        DeviceSubmitBusy = true;
        ToastMessage = null;
        DeviceFormError = null;
        DeviceFormSuccess = null;

        var ip = SanitizeIp(NewDeviceIp);
        var dup = GatewayDevices.FirstOrDefault(d =>
            string.Equals(SanitizeIp(d.IpAddress ?? ""), ip, StringComparison.OrdinalIgnoreCase));
        if (dup != null)
        {
            DeviceFormError = $"IP address '{ip}' is already registered to gateway '{dup.Name}' ({dup.ExternalId}).";
            DeviceSubmitBusy = false;
            return;
        }

        var req = new ScadaDemoTestApiClient.CreateGatewayDeviceRequest(
            NewDeviceName.Trim(), NewDeviceHardware, ip, NewDevicePort, NewDeviceBaud,
            NewDeviceParityStop, 1, NewDeviceTimeout, null);

        var (ok, data, err) = await Api.CreateGatewayDeviceAsync(req);
        if (!ok)
        {
            DeviceFormError = err ?? "Failed to create gateway device.";
            DeviceSubmitBusy = false;
            return;
        }

        DeviceFormSuccess = $"Gateway '{data!.Name}' connected successfully.";
        DeviceIpMessage = null;
        await Task.Delay(450); // brief success pulse before closing the modal
        ShowDeviceModal = false;
        DeviceSubmitBusy = false;
        await LoadGatewaysAsync();
        await ToastAsync($"Gateway '{data.Name}' registered — it will show ONLINE when reachable and OFFLINE when disconnected.", false);
    }

    private static string MeterReading(ScadaDemoTestApiClient.ScannedMeterDto m)
        => $"{MetricValueFormat.Display(m.LivePrimary, m.UnitPrimary)} {m.UnitPrimary}  |  {MetricValueFormat.Display(m.LiveSecondary, m.UnitSecondary)} {m.UnitSecondary}";

    private int _toastSeq;
    private async Task ToastAsync(string msg, bool err)
    {
        var seq = ++_toastSeq;
        ToastMessage = msg;
        ToastIsError = err;
        StateHasChanged();
        await Task.Delay(1700);
        if (_toastSeq == seq && ToastMessage == msg)
        {
            ToastMessage = null;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}