@using scada_demo_test.Web.Services
@page "/gateway"
@attribute [Authorize(Policy = "Tab:Gateway")]
@inject ScadaDemoTestApiClient Api
@implements IDisposable

<div class="page-header-flex">
    <div>
        <h1 class="page-title">Gateway — Smart RS-485 Bus Scan</h1>
        <p class="page-subtitle">Add a gateway, find the meters wired to its RS-485 bus, then map them into sensors in one click — nothing is saved until you add</p>
    </div>
    <button class="btn-primary-scada" @onclick="OpenAddDeviceModal">
        <span>+ Add Gateway</span>
    </button>
</div>

@if (!string.IsNullOrEmpty(ToastMessage))
{
    <div class="scada-toast @(ToastIsError ? "error" : "success")">
        <span>@(ToastIsError ? "✕" : "✓")</span>
        <span>@ToastMessage</span>
        <button class="toast-close" @onclick="() => ToastMessage = null">✕</button>
    </div>
}

@* ---------- Step 1: registered gateways ---------- *@
<h3 style="color:var(--text-primary);font-size:0.95rem;margin:1rem 0 0.5rem;text-transform:uppercase;letter-spacing:0.5px;">Registered Gateways</h3>

@if (GatewayDevices.Count == 0 && !Loading)
{
    <div class="glass-card" style="text-align:center;padding:2.5rem;">
        <div style="font-size:2rem;margin-bottom:0.5rem;">🔌</div>
        <h3 style="color:var(--text-primary);margin-bottom:0.4rem;">No Gateways Yet</h3>
        <p style="color:var(--text-muted);font-size:0.9rem;">Click <strong>+ Add Gateway</strong> to register a USR-W610 (Modbus TCP) or Norvi gateway, then come back here to scan its bus.</p>
    </div>
}

@if (Loading)
{
    <div class="glass-card" style="text-align:center;padding:2rem;color:var(--text-muted);">Loading gateways…</div>
}
else
{
    <div style="display:flex;flex-direction:column;gap:0.7rem;">
        @foreach (var d in GatewayDevices)
        {
            var isSelected = SelectedGatewayGuid == d.Id;
            <div class="glass-card" style="padding:0.9rem 1.1rem;cursor:pointer;border:1px solid @(isSelected ? "var(--primary-blue)" : "var(--border)");box-shadow:@(isSelected ? "0 0 0 1px var(--primary-blue)" : "none");"
                 @onclick="() => SelectGateway(d)">
                <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.6rem;">
                    <div style="display:flex;align-items:center;gap:0.8rem;">
                        <div style="width:36px;height:36px;border-radius:8px;display:flex;align-items:center;justify-content:center;background:@(d.IsOnline ? "rgba(16,185,129,0.12)" : "rgba(148,163,184,0.12)");">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="@(d.IsOnline ? "var(--accent-emerald)" : "var(--text-muted)")" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="3" width="20" height="14" rx="2"/>
                                <line x1="8" y1="21" x2="16" y2="21"/>
                                <line x1="12" y1="17" x2="12" y2="21"/>
                            </svg>
                        </div>
                        <div>
                            <div style="font-weight:700;color:var(--text-primary);">
                                @d.Name <span style="font-size:0.72rem;font-weight:600;padding:0.12rem 0.45rem;border-radius:6px;background:var(--bg-surface);color:var(--text-muted);border:1px solid var(--border);">@d.ExternalId</span>
                            </div>
                            <div style="color:var(--text-muted);font-size:0.8rem;">
                                <strong>@d.HardwareType</strong> &bull; <code style="color:var(--primary-blue);">@d.IpAddress:@d.Port</code> &bull; @d.SensorCount sensors
                            </div>
                        </div>
                    </div>
                    <div style="display:flex;align-items:center;gap:0.6rem;flex-wrap:wrap;">
                        <span style="font-size:0.75rem;font-weight:700;padding:0.28rem 0.7rem;border-radius:12px;background:@(d.IsOnline ? "rgba(16,185,129,0.15)" : "rgba(148,163,184,0.15)");color:@(d.IsOnline ? "var(--accent-emerald)" : "var(--text-muted)");">
                            @(d.IsOnline ? "● ONLINE" : "○ OFFLINE")
                        </span>
                        <button class="btn-secondary-scada" style="font-size:0.75rem;padding:0.3rem 0.7rem;"
                                @onclick="() => ScanFromCard(d)" @onclick:stopPropagation
                                disabled="@(Scanning || string.IsNullOrWhiteSpace(d.IpAddress))">
                            @(Scanning && SelectedGatewayGuid == d.Id ? "Scanning…" : "🔍 Find Sensors")
                        </button>
                        <button class="btn-small" style="background:rgba(239,68,68,0.1);color:#ef4444;border:1px solid rgba(239,68,68,0.25);border-radius:6px;padding:0.3rem 0.65rem;font-size:0.75rem;font-weight:600;"
                                @onclick="() => PromptDeleteDevice(d)" @onclick:stopPropagation
                                disabled="@DeleteBusy">
                            Delete
                        </button>
                    </div>
                </div>

                @* ---------- always-visible child sensors of this gateway ---------- *@
                <div style="margin-top:0.7rem;padding-top:0.6rem;border-top:1px solid var(--border);" @onclick:stopPropagation>
                    @if (AllChildren.TryGetValue(d.Id, out var childList) && childList.Count > 0)
                    {
                        <div style="font-weight:700;color:var(--text-primary);font-size:0.85rem;margin-bottom:0.45rem;">Attached Sensor Children (@childList.Count)</div>
                        @foreach (var s in childList)
                        {
                            <div style="display:flex;justify-content:space-between;align-items:center;padding:0.45rem 0.2rem;border-bottom:1px solid var(--border);gap:0.6rem;flex-wrap:wrap;">
                                <div style="display:flex;align-items:flex-start;gap:0.5rem;min-width:0;">
                                    <span style="width:24px;height:24px;border-radius:5px;background:var(--primary-blue-light);display:inline-flex;align-items:center;justify-content:center;font-size:0.72rem;font-weight:700;color:var(--primary-blue);margin-top:0.1rem;">@s.SlaveAddress</span>
                                    <div style="min-width:0;">
                                        <div style="font-weight:600;color:var(--text-primary);font-size:0.85rem;">@s.Name</div>
                                        <div style="color:var(--text-muted);font-size:0.74rem;">
                                            ID: <code>@s.UniqueSensorId</code> &bull; Slave <code>@("0x" + s.SlaveAddress.ToString("X2"))</code> &bull; @(s.DriverDisplayName?.Split('(')[0]?.Trim())
                                        </div>
                                        <div style="font-size:0.82rem;">
                                            <span style="font-weight:700;color:var(--primary-blue);font-family:monospace;">@MetricValueFormat.Display(s.LatestPrimary, s.UnitPrimary)</span>
                                            <span style="font-weight:700;color:var(--text-primary);font-family:monospace;margin-left:0.6rem;">@MetricValueFormat.Display(s.LatestSecondary, s.UnitSecondary)</span>
                                            <span style="color:var(--text-muted);font-size:0.72rem;margin-left:0.5rem;">@(s.LatestTimestampUtc.HasValue ? s.LatestTimestampUtc.Value.ToLocalTime().ToString("HH:mm:ss") : "no live data")</span>
                                        </div>
                                    </div>
                                </div>
                                <div style="display:flex;align-items:center;gap:0.5rem;">
                                    <span style="font-size:0.72rem;font-weight:700;padding:0.2rem 0.55rem;border-radius:12px;background:@(s.IsOnline ? "rgba(16,185,129,0.15)" : "rgba(148,163,184,0.15)");color:@(s.IsOnline ? "var(--accent-emerald)" : "var(--text-muted)");">
                                        @(s.IsOnline ? "ONLINE" : "OFFLINE")
                                    </span>
                                    <button class="btn-small" style="border:1px solid var(--border);padding:0.25rem 0.6rem;border-radius:6px;background:var(--bg-surface);color:var(--primary-blue);font-size:0.75rem;font-weight:600;"
                                            @onclick="() => OpenEditSensor(s)" @onclick:stopPropagation>
                                        ⚙ Edit Parameters
                                    </button>
                                    <button class="btn-small" style="background:rgba(239,68,68,0.1);color:#ef4444;border:1px solid rgba(239,68,68,0.25);border-radius:6px;padding:0.25rem 0.6rem;font-size:0.75rem;font-weight:600;"
                                            @onclick="() => PromptDeleteSensor(s)" @onclick:stopPropagation
                                            disabled="@DeleteBusy">
                                        Delete Sensor
                                    </button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div style="color:var(--text-muted);font-size:0.8rem;padding:0.2rem 0;">
                            No field sensors attached to this gateway yet — use <strong>🔍 Find Sensors</strong> to discover meters on its RS-485 bus.
                        </div>
                    }
                </div>

                @if (isSelected)
                {
                    <div style="margin-top:0.7rem;padding-top:0.6rem;border-top:1px solid var(--border);" @onclick:stopPropagation>
                        @if (Scanning)
                        {
                            <div style="color:var(--text-muted);font-size:0.78rem;">Scanning @(ScanModeLabel) — registered sensors auto-skipped…</div>
                        }
                        else if (string.IsNullOrWhiteSpace(d.IpAddress))
                        {
                            <div style="color:var(--accent-rose);font-size:0.8rem;">No IP set — edit the gateway's IP address first.</div>
                        }

                        @if (ScanFailed)
                        {
                            <div style="color:var(--accent-rose);font-size:0.85rem;padding:0.4rem 0;">Gateway did not respond during the scan. Confirm it is powered + reachable and is a Modbus TCP gateway, then retry.</div>
                        }

                        @if (!Scanning && SelectedGatewayGuid == d.Id && string.IsNullOrWhiteSpace(d.IpAddress) == false)
                        {
                            <div style="margin-top:0.5rem;display:flex;flex-direction:column;gap:0.4rem;align-items:flex-start;" @onclick:stopPropagation>
                                <button class="btn-secondary-scada" style="font-size:0.78rem;padding:0.35rem 0.8rem;align-self:flex-start;"
                                        @onclick="() => QuickScanAsync()" disabled="@Scanning">
                                    ⚡ Quick 1-20
                                </button>
                                <button class="btn-primary-scada" style="font-size:0.78rem;padding:0.35rem 0.8rem;align-self:flex-start;"
                                        @onclick="() => FullScanAsync()" disabled="@Scanning">
                                    🔍 Find Sensors (Full 1-247)
                                </button>
                            </div>
                        }

                        @if (LastScan != null)
                        {
                            @* ---------- Step 3: detection + multi-select ---------- *@
                            <div style="border:1px solid var(--border);border-radius:8px;padding:0.85rem 1rem;background:var(--bg-card);margin-top:0.6rem;">
                                <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.5rem;margin-bottom:0.6rem;">
                                    <div style="color:var(--text-primary);font-size:0.88rem;font-weight:700;">
                                        Detected Meters — @(LastScan.Found?.Count ?? 0) (probe @LastScan.ProbeTimeoutMs ms, @LastScan.SlavesScanned addresses scanned)
                                    </div>
                                    <div style="display:flex;align-items:center;gap:0.8rem;">
                                        @if (LastScan.Found is { Count: > 0 })
                                        {
                                            <label style="display:flex;align-items:center;gap:0.35rem;color:var(--text-muted);font-size:0.78rem;" @onclick:stopPropagation>
                                                <input type="checkbox" @bind="SelectAllFound" @bind:after="ToggleSelectAll" /> Select All
                                            </label>
                                        }
                                        <button class="btn-small" style="border:none;background:transparent;color:var(--text-muted);font-size:0.9rem;" @onclick="ClearScan" @onclick:stopPropagation>✕</button>
                                    </div>
                                </div>

                                 @if (LastScan.DuplicateIdConflicts?.Count > 0)
                                 {
                                     foreach (var c in LastScan.DuplicateIdConflicts)
                                     {
                                         <div class="modal-alert warning" style="margin-bottom:0.5rem;">⚠️ @c.Message</div>
                                     }
                                 }
                                 @if (LastScan.AmbiguousSlaves?.Count > 0)
                                 {
                                     foreach (var s in LastScan.AmbiguousSlaves)
                                     {
                                         <div class="modal-alert warning" style="margin-bottom:0.5rem;">⚠️ Slave @s is ambiguous — confirm the meter type from the candidates below.</div>
                                     }
                                 }
                                 @if (LastScan.Found != null && LastScan.Found.Count == 0)
                                 {
                                     <div style="color:var(--text-muted);font-size:0.85rem;">No meters responded on this bus. Check wiring, slave addresses and gateway configuration.</div>
                                 }
                                else
                                {
                                    @foreach (var m in LastScan.Found ?? new List<ScadaDemoTestApiClient.ScannedMeterDto>())
                                    {
                                        var isChecked = ConfirmSelection.Contains(m.SlaveAddress);
                                        var isUnknown = m.Status != "identified";
                                        <div style="display:flex;justify-content:space-between;align-items:center;padding:0.5rem 0.2rem;border-bottom:1px solid var(--border);gap:0.75rem;flex-wrap:wrap;">
                                            <div style="display:flex;align-items:center;gap:0.75rem;">
                                                <input type="checkbox" disabled="@isUnknown" style="accent-color:var(--primary-blue);" @onclick:stopPropagation
                                                       checked="@isChecked" @onchange="() => ToggleOne(m.SlaveAddress)" />
                                                <div style="width:32px;height:32px;border-radius:6px;display:flex;align-items:center;justify-content:center;background:var(--primary-blue-light);border:1px solid rgba(2,132,199,0.2);font-size:0.85rem;font-weight:700;color:var(--primary-blue);">@m.SlaveAddress</div>
                                                <div>
                                                    <div style="font-weight:600;color:var(--text-primary);font-size:0.9rem;">@m.DisplayName @if(m.IsAmbiguous){<span style="color:var(--accent-amber);font-size:0.75rem;margin-left:0.3rem;">(ambiguous)</span>}</div>
                                                    <div style="color:var(--text-muted);font-size:0.76rem;">
                                                        @if (!isUnknown)
                                                        {
                                                            @MeterReading(m)
                                                        }
                                                        else
                                                        {
                                                            <text>Responded but register map not recognized — can't map automatically.</text>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }

                                @if (LastScan.SkippedSlaves != null && LastScan.SkippedSlaves.Count > 0)
                                {
                                    <div style="margin-top:0.55rem;color:var(--text-muted);font-size:0.76rem;">
                                        Auto-skipped @LastScan.SkippedSlaves.Count registered slave(s): @string.Join(", ", LastScan.SkippedSlaves)
                                    </div>
                                }

                                <div style="margin-top:0.8rem;">
                                    @if (ConfirmSelection.Count == 0)
                                    {
                                        <span style="color:var(--text-muted);font-size:0.78rem;">Select meter(s) above to enable adding sensors to the application.</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (isSelected)
            {
                @* ---------- Step 4: configure picked meters + children ---------- *@
                @if (PickedMeters.Count > 0)
                {
                    <div style="border:1px solid var(--primary-blue);border-left:4px solid var(--primary-blue);border-radius:8px;padding:0.9rem 1rem;background:var(--bg-card);margin:-0.2rem 0 0.9rem 0;">
                        <div style="font-weight:700;color:var(--text-primary);font-size:0.88rem;margin-bottom:0.5rem;">Selected Meters (@PickedMeters.Count)</div>
                        <div style="display:flex;flex-direction:column;gap:0.5rem;">
                            @foreach (var p in PickedMeters)
                            {
                                <div style="display:flex;justify-content:space-between;align-items:center;gap:0.7rem;flex-wrap:wrap;padding:0.5rem 0.7rem;border:1px solid var(--border);border-radius:6px;">
                                    <div style="display:flex;align-items:center;gap:0.6rem;">
                                        <div style="width:28px;height:28px;border-radius:6px;background:var(--primary-blue-light);display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;color:var(--primary-blue);">@p.Meter.SlaveAddress</div>
                                        <div>
                                            <div style="font-weight:600;color:var(--text-primary);font-size:0.88rem;">
                                                @p.SensorName
                                                @if (p.Added)
                                                {
                                                    <span style="color:var(--accent-emerald);font-size:0.75rem;font-weight:700;"> ✓ Added</span>
                                                }
                                            </div>
                                            <div style="color:var(--text-muted);font-size:0.76rem;">
                                                @p.Meter.DisplayName &bull; Slave @p.Meter.SlaveAddress &bull; @(p.SelectedParams.Count) parameter(s) selected
                                            </div>
                                        </div>
                                    </div>
                                    <button class="btn-secondary-scada" style="font-size:0.78rem;padding:0.35rem 0.7rem;"
                                            @onclick="() => ConfigureMeter(p)" disabled="@p.Added">
                                        @(p.Added ? "Added" : "Configure & Add")
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        }
    </div>
}

@* ---------- Available driver library chips ---------- *@
@if (SensorLibraries.Count > 0)
{
    <div style="margin-top:1rem;">
        <div style="color:var(--text-muted);font-size:0.78rem;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.4rem;">Installed Driver Library (auto-identified on the bus)</div>
        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
            @foreach (var lib in SensorLibraries)
            {
                <span style="padding:0.3rem 0.75rem;border:1px solid var(--border);border-radius:20px;background:var(--bg-card);color:var(--text-primary);font-size:0.78rem;">
                    @lib.DisplayName
                </span>
            }
        </div>
    </div>
}

@* ---- Add Gateway Modal ---- *@
@if (ShowDeviceModal)
{
    <div class="modal-overlay" @onclick="() => ShowDeviceModal = false">
        <div class="modal-card glass-card" style="min-width:480px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>Add Gateway</h3>
                <button class="modal-close" @onclick="() => ShowDeviceModal = false">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-grid-2">
                    <div class="form-group">
                        <label>Gateway Name *</label>
                        <input class="custom-input" @bind="NewDeviceName" placeholder="e.g. Plant-1 RS-485 Gateway" />
                    </div>
                    <div class="form-group">
                        <label>Hardware Type *</label>
                        <select class="custom-select" @bind="NewDeviceHardware">
                            <option value="USR-W610">USR-W610</option>
                            <option value="Norvi (ESP32)">Norvi (ESP32)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>IP Address *</label>
                        <input class="custom-input" @bind="NewDeviceIp" @bind:after="OnDeviceIpChanged" placeholder="192.168.100.56" />
                    </div>
                    <div class="form-group">
                        <label>Port (Default 502)</label>
                        <input type="number" class="custom-input" @bind="NewDevicePort" />
                    </div>
                    <div class="form-group">
                        <label>Baud Rate</label>
                        <select class="custom-select" @bind="NewDeviceBaud">
                            <option value="4800">4800</option>
                            <option value="9600">9600</option>
                            <option value="19200">19200</option>
                            <option value="115200">115200</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Parity / Stop Bits</label>
                        <select class="custom-select" @bind="NewDeviceParityStop">
                            <option value="None">None / 1</option>
                            <option value="Even">Even / 1</option>
                            <option value="Odd">Odd / 1</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Response Timeout (ms)</label>
                        <input type="number" class="custom-input" @bind="NewDeviceTimeout" />
                    </div>
                </div>
                @if (DeviceFormSuccess != null)
                {
                    <div class="modal-alert success">✓ @DeviceFormSuccess</div>
                }
                @if (DeviceFormError != null)
                {
                    <div class="modal-alert error">✕ @DeviceFormError</div>
                }
                @if (DeviceIpMessage != null)
                {
                    <div class="modal-alert warning">⚠️ @DeviceIpMessage</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-secondary-scada" @onclick="() => ShowDeviceModal = false" disabled="@DeviceSubmitBusy">Cancel</button>
                <button class="btn-primary-scada" @onclick="SubmitDeviceAsync"
                        disabled="@(DeviceSubmitBusy || string.IsNullOrWhiteSpace(NewDeviceName) || string.IsNullOrWhiteSpace(NewDeviceIp) || DeviceIpMessage != null)">
                    Save Gateway
                </button>
            </div>
        </div>
    </div>
}

@* ---- Configure Meter Modal ---- *@
@if (Configuring is { } cfg)
{
    <div class="modal-overlay">
        <div class="modal-card glass-card" style="min-width:500px;">
            <div class="modal-header">
                <h3>Configure &amp; Add Sensor</h3>
                <button class="modal-close" @onclick="() => Configuring = null">✕</button>
            </div>
            <div class="modal-body">
                <div style="padding:0.5rem 0.6rem;border:1px solid var(--border);border-radius:6px;background:var(--bg-surface);margin-bottom:0.9rem;">
                    <div style="font-weight:600;color:var(--text-primary);font-size:0.9rem;">@cfg.Meter.DisplayName</div>
                    <div style="color:var(--text-muted);font-size:0.78rem;">
                        Slave @cfg.Meter.SlaveAddress &bull; regs @cfg.Meter.StartRegister-@(cfg.Meter.StartRegister + cfg.Meter.RegisterQuantity - 1) &bull; @MeterReading(cfg.Meter)
                    </div>
                </div>

                <div class="form-grid-2">
                    <div class="form-group">
                        <label>Sensor Name *</label>
                        <input class="custom-input" @bind="cfg.SensorName" placeholder="e.g. Boiler Gas Flowmeter" />
                    </div>
                    <div class="form-group">
                        <label>Modbus Slave Address *</label>
                        <input type="number" class="custom-input" @bind="cfg.SlaveAddress" @bind:after="OnConfigSlaveChanged" />
                    </div>
                    <div class="form-group">
                        <label>Poll Interval (sec)</label>
                        <input type="number" class="custom-input" @bind="cfg.PollIntervalSeconds" />
                    </div>
                    <div class="form-group">
                        <label>Calibration Multiplier</label>
                        <input type="number" step="0.1" class="custom-input" @bind="cfg.CalibrationMultiplier" />
                    </div>
                </div>

                <div class="form-group" style="margin-top:0.6rem;">
                    <label>Select Parameters (from this meter)</label>
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.35rem;">
                        <span style="color:var(--text-muted);font-size:0.78rem;">@(Configuring.SelectedParams.Count) of @ParamsFor(Configuring.Meter).Count selected</span>
                        <span style="display:flex;gap:0.4rem;">
                            <button type="button" style="border:1px solid var(--border);padding:0.2rem 0.6rem;border-radius:6px;background:var(--bg-surface);color:var(--primary-blue);font-size:0.74rem;font-weight:600;cursor:pointer;"
                                    @onclick="() => ToggleAllParams(true)">Select All</button>
                            <button type="button" style="border:1px solid var(--border);padding:0.2rem 0.6rem;border-radius:6px;background:var(--bg-surface);color:#ef4444;font-size:0.74rem;font-weight:600;cursor:pointer;"
                                    @onclick="() => ToggleAllParams(false)">Clear</button>
                        </span>
                    </div>
                    <div style="display:flex;flex-direction:column;gap:0.4rem;">
                        @foreach (var p in ParamsFor(cfg.Meter))
                        {
                            <label style="display:flex;align-items:center;gap:0.5rem;padding:0.35rem 0.6rem;border:1px solid var(--border);border-radius:6px;background:var(--bg-surface);cursor:pointer;font-size:0.85rem;">
                                <input type="checkbox" checked="@cfg.SelectedParams.Contains(p.Key)" @onchange="(e) => ToggleParam(p.Key, (bool)e.Value!)"
                                       style="accent-color:var(--primary-blue);" />
                                <span style="font-weight:600;color:var(--text-primary);">@p.Label</span>
                                <span style="color:var(--text-muted);">@p.Unit</span>
                                <span style="color:var(--primary-blue);font-family:monospace;font-size:0.72rem;margin-left:auto;">@p.Key</span>
                            </label>
                        }
                    </div>
                    @if (Configuring.SelectedParams.Count == 0)
                    {
                        <div class="modal-alert warning" style="margin-top:0.5rem;">⚠️ Select at least one parameter to add this sensor.</div>
                    }
                </div>

                @if (HasTankSupport(cfg.Meter.DriverKey ?? ""))
                {
                    <div class="tank-toggle-box">
                        <div>
                            <div class="tank-toggle-title">Storage Tank asset</div>
                            <div class="tank-toggle-hint">Level = Totalizer ÷ capacity — shows on the Storage Tanks page</div>
                        </div>
                        <input type="checkbox" @bind="cfg.IsTank" class="tank-checkbox" />
                    </div>
                    @if (cfg.IsTank)
                    {
                        <div class="form-grid-2" style="margin-top:0.5rem;">
                            <div class="form-group">
                                <label>Capacity (m³)</label>
                                <input type="number" step="0.1" min="0" class="custom-input" @bind="cfg.TankCapacity" />
                            </div>
                            <div class="form-group">
                                <label>Holds</label>
                                <input class="custom-input" @bind="cfg.LiquidType" placeholder="e.g. Water" />
                            </div>
                        </div>
                    }
                }

                @if (ConfigSlaveMessage != null)
                {
                    <div class="modal-alert warning">⚠️ @ConfigSlaveMessage</div>
                }
                @if (ConfigFormError != null)
                {
                    <div class="modal-alert error">✕ @ConfigFormError</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-secondary-scada" @onclick="() => Configuring = null" disabled="@ConfigSubmitBusy">Cancel</button>
                <button class="btn-primary-scada" @onclick="AddMeterAsSensor"
                        disabled="@(ConfigSubmitBusy || string.IsNullOrWhiteSpace(cfg.SensorName) || ConfigSlaveMessage != null || cfg.SelectedParams.Count == 0)">
                    Add Sensor to Application
                </button>
            </div>
        </div>
    </div>
}

