@page "/dashboard"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Tab:Energy")]
@using scada_demo_test.Web.Services
@inject ScadaDemoTestApiClient Api
@inject LiveTelemetryState State
@implements IAsyncDisposable

<div class="page-header">
    <h1 class="page-title">Dashboard</h1>
    <p class="page-subtitle page-subtitle-soft">Everything on one page: gateways, every sensor's live values, totalizers and active alerts - all real data, no simulation</p>
</div>

@if (Loading)
{
    <div class="glass-card" style="padding:2.5rem;text-align:center;color:var(--text-muted);">Loading dashboard&hellip;</div>
}
else
{
    <div class="kpi-strip">
        <div class="kpi-card">
            <span class="kpi-label">Sensors</span>
            <span class="kpi-value">@Cards.Count</span>
            <span style="font-size:11px;color:var(--text-muted);">total registered</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">Online</span>
            <span class="kpi-value" style="color:var(--accent-emerald);">@KpiOnline</span>
            <span style="font-size:11px;color:var(--text-muted);">streaming now</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">Offline</span>
            <span class="kpi-value" style="color:var(--text-light);">@(Cards.Count - KpiOnline)</span>
            <span style="font-size:11px;color:var(--text-muted);">waiting for gateway</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">Gateways</span>
            <span class="kpi-value">@GatewaysOnline<span style="font-size:1rem;font-weight:600;color:var(--text-muted);"> / @Gateways.Count</span></span>
            <span style="font-size:11px;color:var(--text-muted);">reachable online</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">Total flow</span>
            <span class="kpi-value">@MetricValueFormat.Display(KpiFlow, KpiFlowUnit)</span>
            <span style="font-size:11px;color:var(--text-muted);">sum of online flowmeters</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">Total volume</span>
            <span class="kpi-value">@MetricValueFormat.Display(KpiVolume, KpiVolumeUnit)</span>
            <span style="font-size:11px;color:var(--text-muted);">sum of totalizers</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">Active alerts</span>
            <span class="kpi-value" style="color:@(ActiveAlertCount > 0 ? "var(--accent-rose)" : "var(--accent-emerald)");">@ActiveAlertCount</span>
            <span style="font-size:11px;color:var(--text-muted);">unacknowledged incidents</span>
        </div>
    </div>

    <div class="eg-toolbar">
        <button type="button" class="btn-primary-scada" @onclick="RefreshAsync" @onclick:preventDefault disabled="@Loading">
            @(Refreshing ? "Refreshing..." : "Refresh now")
        </button>
        <span class="eg-clock">Last update @Clock</span>
        <span class="eg-muted">Source: /api/devices + /api/sensors + SignalR telemetry + /api/alerts - no simulated values</span>
    </div>

    <div class="dash-section-title">Gateways</div>
    @if (Gateways.Count == 0)
    {
        <div class="glass-card" style="padding:1.5rem;text-align:center;color:var(--text-muted);font-size:0.9rem;">
            No gateways added yet. Open <strong>Devices &gt; Gateway</strong> to add one.
        </div>
    }
    else
    {
        <div class="dash-gateways">
            @foreach (var g in Gateways)
            {
                <div class="dash-gw">
                    <div class="dash-gw-main">
                        <span class="dash-gw-name">@g.Name</span>
                        <span class="eg-tag">@g.ExternalId</span>
                        <span class="status-pill @(g.IsOnline ? "online" : "offline")">
                            <span class="status-dot @(g.IsOnline ? "online" : "offline")"></span>
                            @(g.IsOnline ? "ONLINE" : "OFFLINE")
                        </span>
                    </div>
                    <div class="dash-gw-meta">@g.HardwareType &bull; @(string.IsNullOrWhiteSpace(g.IpAddress) ? "no IP" : g.IpAddress):@g.Port &bull; Sensors @g.SensorCount/@g.MaxSensorCapacity</div>
                    <div class="dash-gw-seen">Last seen @FmtSeen(g.LastSeenAt)</div>
                </div>
            }
        </div>
    }

    <div class="dash-section-title">Live Sensors</div>
    @if (Cards.Count == 0)
    {
        <div class="glass-card" style="text-align:center;padding:3rem;">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:0.5rem;">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
            <h3 style="color:var(--text-primary);">No Sensors Registered</h3>
            <p style="color:var(--text-muted);font-size:0.9rem;max-width:560px;margin:0 auto;">
                Add a gateway and attach sensors from <strong>Devices &gt; Gateway</strong>. Every sensor added here
                appears below with live gauges - no configuration needed.
            </p>
        </div>
    }
    else
    {
        @if (KpiOnline == 0)
        {
            <div class="eg-warn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <span>@Cards.Count sensor(s) registered but none are online right now - the gateway is not reachable. Live values will appear automatically the moment it connects.</span>
            </div>
        }

        <div class="eg-groups">
            @foreach (var c in Cards)
            {
                <section class="eg-group">
                    <div class="eg-head">
                        <div class="eg-title">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                            </svg>
                            <span>@c.Name</span>
                        </div>
                        <div class="eg-headright">
                            <span class="eg-tag">@c.TrendTag</span>
                            <span class="status-pill @(c.IsOnline ? "online" : "offline")">
                                <span class="status-dot @(c.IsOnline ? "online" : "offline")"></span>
                                @(c.IsOnline ? "ONLINE" : "OFFLINE")
                            </span>
                        </div>
                    </div>

                    <div class="eg-body">
                        @for (var h = 0; h < 2; h++)
                        {
                            var m = h == 0 ? c.A : c.B;
                            if (m is null)
                            {
                                <div class="eg-half empty">
                                    <h3 class="eg-half-title">@(h == 0 ? "Primary" : "Secondary")</h3>
                                    <div class="eg-empty">No metric selected</div>
                                </div>
                            }
                            else
                            {
                                <div class="eg-half">
                                    <h3 class="eg-half-title">@m!.Label</h3>
                                    <div class="eg-gauge @(c.IsOnline ? "" : "offline")">
                                        @((MarkupString)m!.Svg)
                                    </div>
                                    <div class="eg-rows">
                                        <div class="eg-row"><span class="lbl">Live value</span><span class="val">@m!.DisplayValue</span></div>
                                        <div class="eg-row"><span class="lbl">Unit</span><span class="val unit">@(m!.Unit ?? "&mdash;")</span></div>
                                        <div class="eg-row"><span class="lbl">Scale</span><span class="val unit">0 &mdash; @m!.MaxText @(m!.Unit ?? "")</span></div>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <div class="eg-foot">
                        <span class="eg-foot-dot @(c.IsOnline ? "online" : "offline")"></span>
                        <div>
                            <div class="eg-conn-line">Slave @c.Slave &bull; via @c.DeviceName</div>
                            <div class="eg-conn-seen">Last seen @FmtSeen(c.LastSeen)</div>
                        </div>
                    </div>
                </section>
            }
        </div>
    }

    <div class="dash-section-title">Recent Alerts</div>
    @if (Incidents.Count == 0)
    {
        <div class="glass-card" style="padding:1.5rem;text-align:center;color:var(--text-muted);font-size:0.9rem;">
            No alert incidents yet. Rules are evaluated on every live reading.
        </div>
    }
    else
    {
        <div class="dash-alerts">
            @foreach (var inc in Incidents)
            {
                <div class="dash-alert">
                    <div class="dash-alert-left">
                        <span class="sev-pill @inc.Severity.ToLowerInvariant()">@inc.Severity</span>
                        <div>
                            <div class="dash-alert-msg">@inc.Message</div>
                            <div class="dash-alert-meta">@inc.DeviceName &bull; @inc.Metric = @Format(inc.TriggerValue) &bull; @inc.TriggeredAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</div>
                        </div>
                    </div>
                    <div class="dash-alert-right">
                        @if (inc.AcknowledgedAt.HasValue)
                        {
                            <span class="eg-muted">Acknowledged</span>
                        }
                        else if (inc.IsResolved)
                        {
                            <span class="eg-muted">Resolved</span>
                        }
                        else
                        {
                            <button type="button" class="btn-secondary-scada" @onclick="() => AcknowledgeAsync(inc.Id)">Acknowledge</button>
                        }
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private sealed class MetricView
    {
        public string Key = "";
        public string Label = "";
        public double? Value;
        public string? Unit;
        public double Max = 100;
        public double? Frac;
        public string Svg = "";
        public string DisplayValue = "--";
        public string MaxText = "100";
        public string Suffix = "";
    }

    private sealed class SensorCard
    {
        public string SensorTag = "";
        public string Name = "";
        public string DeviceName = "";
        public int Slave;
        public bool IsOnline;
        public DateTime? LastSeen;
        public MetricView? A;
        public MetricView? B;
        public string TrendTag = "";
    }

    private List<SensorCard> Cards = new();
    private List<ScadaDemoTestApiClient.GatewayDeviceDto> Gateways = new();
    private List<ScadaDemoTestApiClient.AlertIncidentDto> Incidents = new();
    private bool Loading = true;
    private bool Refreshing;
    private bool _disposed;
    private System.Threading.Timer? _refreshTimer;
    private string Clock = DateTime.Now.ToString("HH:mm:ss");
    private int KpiOnline;
    private int GatewaysOnline;
    private int ActiveAlertCount;
    private double? KpiFlow;
    private string? KpiFlowUnit;
    private double? KpiVolume;
    private string? KpiVolumeUnit;

    private static string FmtSeen(DateTime? utc) =>
        utc.HasValue ? utc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") : "&mdash;";

    private static string Format(double v) =>
        v.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    private static Dictionary<string, string> ParseMetricFields(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return new();
        try
        {
            var d = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(json);
            return d ?? new();
        }
        catch { return new(); }
    }

    private static double MaxFor(string? unit)
    {
        if (unit is null) return 100;
        var u = unit.ToLowerInvariant();
        if (u.Contains("%rh") || u.Contains("rh%")) return 100;
        if (u.Contains("°c") || u.StartsWith("c")) return 100;
        if (u.Contains("m³/h") || u.Contains("m3/h") || u.Contains("nm³/h") || u.Contains("nm3/h")) return 1000;
        if (u.Contains("m³") || u.Contains("m3")) return 10000;
        return 100;
    }

    private static string PrettyLabel(string key) => (key.ToLowerInvariant()) switch
    {
        "temperaturec" or "temperature" or "temp" => "Temperature",
        "humidityrh" or "humidity" => "Humidity",
        "instantaneousflowrate" or "flowrate" or "flow" => "Flow Rate",
        "accumulatedtotalizer" or "totalizer" or "total" => "Totalizer",
        "velocity" => "Velocity",
        _ => key
    };

    private MetricView BuildMetric(int index, string key, string? pretty, double? value, string? unit, Guid sensorId)
    {
        var suffix = sensorId.ToString("N") + index;
        var max = MaxFor(unit);
        var frac = value.HasValue ? Math.Clamp(value.Value / max, 0, 1) : 0;
        return new MetricView
        {
            Key = key,
            Label = string.IsNullOrWhiteSpace(pretty) ? PrettyLabel(key) : pretty,
            Value = value,
            Unit = string.IsNullOrWhiteSpace(unit) ? null : unit,
            Max = max,
            Frac = frac,
            DisplayValue = MetricValueFormat.Display(value, unit),
            MaxText = max.ToString("0", System.Globalization.CultureInfo.InvariantCulture),
            Suffix = suffix,
            Svg = GaugeSvg(suffix, key, value, unit, max, frac)
        };
    }

    private static string GaugeSvg(string suffix, string label, double? value, string? unit, double max, double frac)
    {
        const double cx = 110, cy = 104, r = 76, sweep = 260, start = 140;
        static double Rad(double deg) => deg * Math.PI / 180;
        (double X, double Y) Pt(double deg, double rr)
        {
            var a = Rad(deg);
            return (cx + rr * Math.Cos(a), cy + rr * Math.Sin(a));
        }
        string Arc(double from, double to)
        {
            var p1 = Pt(from, r);
            var p2 = Pt(to, r);
            var large = (to - from) > 180 ? 1 : 0;
            return $"M{p1.X:F2} {p1.Y:F2} A{r} {r} 0 {large} 1 {p2.X:F2} {p2.Y:F2}";
        }

        var trackLen = sweep / 360 * 2 * Math.PI * r;
        var valText = value.HasValue
            ? MetricValueFormat.Display(value, unit)
            : "--";
        var a11y = System.Net.WebUtility.HtmlEncode($"{label}: {valText} {unit}");

        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg viewBox=\"0 0 220 168\" role=\"img\" aria-label=\"{a11y}\">");
        sb.Append($"<defs><linearGradient id=\"egrad-{suffix}\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\"><stop offset=\"0\" stop-color=\"#075985\"/><stop offset=\"1\" stop-color=\"#38bdf8\"/></linearGradient></defs>");
        sb.Append($"<path class=\"eg-arc-bg\" d=\"{Arc(start, start + sweep)}\"/>");
        sb.Append($"<path class=\"eg-arc-fill\" stroke=\"url(#egrad-{suffix})\" stroke-dasharray=\"{trackLen:F1} {trackLen + 10:F1}\" stroke-dashoffset=\"{trackLen * (1 - frac):F1}\" d=\"{Arc(start, start + sweep)}\"/>");
        for (var k = 0; k <= 4; k++)
        {
            var f = k / 4d;
            var a = start + f * sweep;
            var t = max * k / 4;
            var tLabel = t.ToString("0", System.Globalization.CultureInfo.InvariantCulture);
            var p1 = Pt(a, r - 9.5);
            var p2 = Pt(a, r + 6.5);
            var ptl = Pt(a, r + 18);
            sb.Append($"<line x1=\"{p1.X:F1}\" y1=\"{p1.Y:F1}\" x2=\"{p2.X:F1}\" y2=\"{p2.Y:F1}\" stroke=\"var(--text-muted)\" stroke-width=\"1.1\"/>");
            sb.Append($"<text class=\"eg-tick-lb\" x=\"{ptl.X:F1}\" y=\"{ptl.Y + 3:F1}\" text-anchor=\"middle\">{tLabel}</text>");
        }
        sb.Append($"<text class=\"eg-g-val\" x=\"110\" y=\"136\" text-anchor=\"middle\">{valText}</text>");
        sb.Append("</svg>");
        return sb.ToString();
    }

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += HandleLiveChange;
        await RefreshAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _refreshTimer = new System.Threading.Timer(async _ =>
            {
                if (_disposed) return;
                try { await InvokeAsync(RefreshAsync); }
                catch { /* circuit disposed */ }
            }, null, 4000, 4000);
        }
    }

    private void HandleLiveChange()
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            try
            {
                if (!_disposed)
                {
                    SyncLiveValues();
                    Clock = DateTime.Now.ToString("HH:mm:ss");
                    StateHasChanged();
                }
            }
            catch { }
        });
    }

    private void SyncLiveValues()
    {
        double? flowSum = null;
        double? volSum = null;
        var online = 0;
        foreach (var c in Cards)
        {
            // Base online state comes from the API DTO (worker-maintained IsOnline
            // = real poll/push success). The SignalR live bus only overrides it when
            // it actually has a reading for this sensor — a silent bus (page just
            // loaded, hub hiccup) must NOT force ONLINE sensors to render OFFLINE.
            if (State.Meters.TryGetValue(c.SensorTag, out var meter) && meter is not null)
            {
                c.IsOnline = meter.IsOnline;
            }
            if (c.IsOnline)
            {
                online++;
                if (State.Meters.TryGetValue(c.SensorTag, out var live) && live is not null && live.LastSeen != default)
                    c.LastSeen = live.LastSeen;
            }
            if (State.Meters.TryGetValue(c.SensorTag, out var m2) && m2 is not null)
            {
                TrySet(c.A, m2.Values);
                TrySet(c.B, m2.Values);
            }
        }
        foreach (var c in Cards)
        {
            foreach (var m in new[] { c.A, c.B })
            {
                if (m is null || !m.Value.HasValue || !c.IsOnline) continue;
                var u = (m.Unit ?? "").ToLowerInvariant();
                if (u.Contains("m³/h") || u.Contains("m3/h") || u.Contains("nm³/h") || u.Contains("nm3/h"))
                {
                    flowSum = (flowSum ?? 0) + m.Value;
                    KpiFlowUnit = m.Unit;
                }
                else if ((u.Contains("m³") || u.Contains("m3")) && !u.Contains("/h"))
                {
                    volSum = (volSum ?? 0) + m.Value;
                    KpiVolumeUnit = m.Unit;
                }
            }
        }
        KpiFlow = flowSum;
        KpiVolume = volSum;
        KpiOnline = online;
        GatewaysOnline = Gateways.Count(g => g.IsOnline);
        ActiveAlertCount = Incidents.Count(i => !i.AcknowledgedAt.HasValue && !i.IsResolved);
    }

    private static void TrySet(MetricView? m, Dictionary<string, (double Value, string? Unit, DateTime Seen)> values)
    {
        if (m is null || string.IsNullOrWhiteSpace(m.Key)) return;
        if (values.TryGetValue(m.Key, out var r))
        {
            m.Value = r.Value;
            m.Unit = r.Unit;
            m.DisplayValue = MetricValueFormat.Display(m.Value, m.Unit);
            if (m.Unit is not null && MaxFor(m.Unit) != m.Max)
            {
                m.Max = MaxFor(m.Unit);
                m.MaxText = m.Max.ToString("0", System.Globalization.CultureInfo.InvariantCulture);
            }
            m.Frac = m.Value.HasValue ? Math.Clamp(m.Value.Value / m.Max, 0, 1) : 0;
            m.Svg = GaugeSvg(m.Suffix, m.Key, m.Value, m.Unit, m.Max, m.Frac.Value);
        }
    }

    private async Task AcknowledgeAsync(Guid id)
    {
        await Api.AcknowledgeAlertAsync(id);
        await ReloadIncidentsAsync();
    }

    private async Task ReloadIncidentsAsync()
    {
        try { Incidents = await Api.GetAlertIncidentsAsync(limit: 15); }
        catch { /* API unreachable - keep list */ }
        SyncLiveValues();
        if (!_disposed) StateHasChanged();
    }

    private async Task RefreshAsync()
    {
        Refreshing = true;
        try
        {
            Gateways = await Api.GetGatewayDevicesAsync();

            var all = new List<ScadaDemoTestApiClient.AttachedSensorDto>();
            var deviceMap = new Dictionary<Guid, string>();
            var batches = await Task.WhenAll(Gateways.Select(async d =>
            {
                deviceMap[d.Id] = d.Name;
                try { return await Api.GetSensorsAsync(d.Id); }
                catch { return new List<ScadaDemoTestApiClient.AttachedSensorDto>(); }
            }));
            foreach (var list in batches) all.AddRange(list);

            var next = new List<SensorCard>();
            foreach (var s in all.OrderBy(s => s.DeviceName).ThenBy(s => s.Name))
            {
                var fields = ParseMetricFields(s.MetricFields);
                var card = new SensorCard
                {
                    SensorTag = s.UniqueSensorId,
                    Name = s.Name,
                    DeviceName = deviceMap.TryGetValue(s.DeviceId, out var n) ? n : s.DeviceName,
                    Slave = s.SlaveAddress,
                    IsOnline = s.IsOnline,
                    LastSeen = s.LatestTimestampUtc,
                    TrendTag = s.UniqueSensorId
                };
                var idx = 0;
                foreach (var f in fields)
                {
                    double? v = null;
                    if (idx == 0) { v = s.LatestPrimary; }
                    else if (idx == 1) { v = s.LatestSecondary; }
                    var unit = f.Value;
                    var m = BuildMetric(idx, f.Key, f.Key, v, unit, s.Id);
                    if (idx == 0) card.A = m; else if (idx == 1) card.B = m;
                    idx++;
                }
                if (card.A is null && s.UnitPrimary is not null)
                {
                    card.A = BuildMetric(0, s.Id.ToString(), "Primary", s.LatestPrimary, s.UnitPrimary, s.Id);
                }
                if (card.B is null && s.UnitSecondary is not null)
                {
                    card.B = BuildMetric(1, s.Id.ToString(), "Secondary", s.LatestSecondary, s.UnitSecondary, s.Id);
                }
                next.Add(card);
            }

            Cards = next;
        }
        catch
        {
            // API unreachable - keep the current list rather than crashing.
        }

        try { Incidents = await Api.GetAlertIncidentsAsync(limit: 15); }
        catch { /* keep current list */ }

        SyncLiveValues();
        Loading = false;
        Refreshing = false;
        Clock = DateTime.Now.ToString("HH:mm:ss");
        if (!_disposed) StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        State.OnChange -= HandleLiveChange;
        if (_refreshTimer is not null)
        {
            await _refreshTimer.DisposeAsync();
            _refreshTimer = null;
        }
    }
}