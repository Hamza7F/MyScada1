@using Microsoft.AspNetCore.Components.Authorization
@using scada_demo_test.Web.Services
@implements IDisposable
@inject AuthenticationStateProvider AuthProvider
@inject ScadaDemoTestApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<header class="topbar">
    <div class="topbar-left">
        <button class="icon-btn" @onclick="OnToggleSidebar" title="Toggle sidebar">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>

        <div class="search-box-wrapper" @onfocusout="CloseSearchDelayed">
            <div class="search-box">
                <span class="search-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </span>
                <input type="text" placeholder="Quick search meters, devices, tanks, alerts..."
                       @bind="SearchQuery" @bind:event="oninput" @onkeydown="HandleSearchKey" @onfocus="() => IsSearchOpen = true" />
                @if (!string.IsNullOrEmpty(SearchQuery))
                {
                    <button type="button" class="toast-close" style="font-size:12px;" @onclick="ClearSearch">✕</button>
                }
            </div>

            @if (IsSearchOpen && !string.IsNullOrWhiteSpace(SearchQuery))
            {
                <div class="search-dropdown-menu">
                    @if (MatchedDevices.Count > 0)
                    {
                        <div class="search-category-title">🛠️ Devices &amp; Meters (@MatchedDevices.Count)</div>
                        @foreach (var d in MatchedDevices.Take(4))
                        {
                            <div class="search-result-row" @onclick="() => NavigateToDevice(d.ExternalId)">
                                <div>
                                    <strong>@d.Name</strong>
                                    <span class="font-mono text-muted" style="font-size:11px; margin-left:6px;">@d.ExternalId</span>
                                </div>
                                <span class="status-pill @(d.Status == "Online" ? "online" : "offline")">@d.Status</span>
                            </div>
                        }
                    }

                    @if (MatchedTanks.Count > 0)
                    {
                        <div class="search-category-title" style="margin-top:6px;">🛢️ Storage Tanks (@MatchedTanks.Count)</div>
                        @foreach (var t in MatchedTanks.Take(3))
                        {
                            <div class="search-result-row" @onclick='() => Nav.NavigateTo("/charts")'>
                                <div>
                                    <strong>@t.Name</strong>
                                    <span class="font-mono text-muted" style="font-size:11px; margin-left:6px;">@t.TankCode</span>
                                </div>
                                <span class="badge-accent">@t.LevelPercentage.ToString("0.0")%</span>
                            </div>
                        }
                    }

                    @if (MatchedAlerts.Count > 0)
                    {
                        <div class="search-category-title" style="margin-top:6px;">🚨 Recent Alerts (@MatchedAlerts.Count)</div>
                        @foreach (var a in MatchedAlerts.Take(3))
                        {
                            <div class="search-result-row" @onclick='() => Nav.NavigateTo("/alerts")'>
                                <div style="display:flex; align-items:center; gap:6px;">
                                    <span class="alert-badge @a.Severity.ToLowerInvariant()">@a.Severity</span>
                                    <span style="font-size:12px;">@a.Message</span>
                                </div>
                            </div>
                        }
                    }

                    @if (MatchedDevices.Count == 0 && MatchedTanks.Count == 0 && MatchedAlerts.Count == 0)
                    {
                        <div style="padding:16px; text-align:center; color:var(--text-muted); font-size:12.5px;">
                            No matching assets found for "@SearchQuery".
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="topbar-right">
        <span class="topbar-clock">@_now.ToString("dddd, dd MMM yyyy · HH:mm:ss")</span>

        @* Dark / light theme toggle. Reads + persists the choice in localStorage so
           it survives a page reload, and honours the OS default on first visit. *@
        <button class="theme-toggle" title="Toggle dark theme" @onclick="ToggleThemeAsync">
            @if (IsDarkTheme)
            {
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                </svg>
            }
            else
            {
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="4"/>
                    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
                </svg>
            }
        </button>

        <!-- Alerts Bell with Dropdown -->
        <div class="notifications-wrapper" tabindex="0" @onclick="ToggleAlertsMenu" @onfocusout="CloseAlertsDelayed">
            <button class="icon-btn bell-btn" title="Alerts &amp; Incidents">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                </svg>
                @if (ActiveAlertsCount > 0)
                {
                    <span class="notification-badge">@ActiveAlertsCount</span>
                }
            </button>

            @if (IsAlertsOpen)
            {
                <div class="alerts-dropdown">
                    <div class="dropdown-header">
                        <strong>Active Incidents (@ActiveAlertsCount)</strong>
                        <a href="/alerts" class="view-all-link">View All Alerts →</a>
                    </div>
                    <div class="dropdown-body">
                        @if (RecentIncidents.Count == 0)
                        {
                            <div class="dropdown-empty">All systems operating normally. No active alarms.</div>
                        }
                        else
                        {
                            @foreach (var inc in RecentIncidents.Take(5))
                            {
                                <div class="alert-item @inc.Severity.ToLowerInvariant()" @onclick='() => Nav.NavigateTo("/alerts")' style="cursor:pointer;">
                                    <div class="alert-item-header">
                                        <span class="alert-badge @inc.Severity.ToLowerInvariant()">@inc.Severity</span>
                                        <span class="alert-time text-muted">@inc.TriggeredAt.ToLocalTime().ToString("HH:mm:ss")</span>
                                    </div>
                                    <div class="alert-msg">@inc.Message</div>
                                    <div class="text-muted" style="font-size:11px; margin-top:2px;">Node: @inc.DeviceName (@inc.DeviceExternalId)</div>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>

        <!-- User Menu -->
        <div class="user-menu" tabindex="0" @onclick="ToggleUserMenu" @onfocusout="CloseUserMenuDelayed">
            <div class="avatar">@Initials</div>
            <div class="user-info">
                <div class="user-name">@DisplayName</div>
                <div class="user-role-badge">@RoleName</div>
            </div>
            <span class="chevron">@(IsUserMenuOpen ? "▲" : "▼")</span>

            @if (IsUserMenuOpen)
            {
                <div class="user-dropdown">
                    <div class="user-dropdown-header">
                        <strong>@DisplayName</strong>
                        <span class="user-dropdown-email">@UserEmail</span>
                    </div>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item" href="/settings">⚙️ System Diagnostics</a>
                    <a class="dropdown-item" href="/audit-logs">📜 Audit Logs</a>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item logout" href="/account/logout">⏻ Sign Out</a>
                </div>
            }
        </div>
    </div>
</header>

@code {
    [Parameter] public EventCallback OnToggleSidebar { get; set; }

    private bool IsUserMenuOpen = false;
    private bool IsAlertsOpen = false;
    private bool IsSearchOpen = false;
    private DateTime _now = DateTime.Now;
    private System.Threading.Timer? _timer;
    private bool _disposed;

    private string DisplayName = "User";
    private string UserEmail = "";
    private string RoleName = "";
    private string Initials = "U";
    private string SearchQuery = "";
private bool IsDarkTheme = false;

    private List<ScadaDemoTestApiClient.DeviceDto> AllDevices = new();
    private List<ScadaDemoTestApiClient.StorageTankDto> AllTanks = new();
    private List<ScadaDemoTestApiClient.AlertIncidentDto> RecentIncidents = new();
    private int ActiveAlertsCount => RecentIncidents.Count(i => !i.IsResolved);

    private List<ScadaDemoTestApiClient.DeviceDto> MatchedDevices =>
        string.IsNullOrWhiteSpace(SearchQuery) ? new() :
        AllDevices.Where(d => d.Name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) || d.ExternalId.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)).ToList();

    private List<ScadaDemoTestApiClient.StorageTankDto> MatchedTanks =>
        string.IsNullOrWhiteSpace(SearchQuery) ? new() :
        AllTanks.Where(t => t.Name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) || t.TankCode.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)).ToList();

    private List<ScadaDemoTestApiClient.AlertIncidentDto> MatchedAlerts =>
        string.IsNullOrWhiteSpace(SearchQuery) ? new() :
        RecentIncidents.Where(a => a.Message.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) || a.DeviceName.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        DisplayName = user.Identity?.Name ?? "SuperAdmin";
        UserEmail = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "superadmin@alamiot.com";
        RoleName = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "SuperAdmin";
        Initials = string.Concat(DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Where(p => p.Length > 0)
            .Select(p => char.ToUpper(p[0])))
            is { Length: > 0 } initials ? initials[..Math.Min(2, initials.Length)] : "SA";

        await LoadDataAsync();

        // Theme: honour localStorage first, then the OS preference, then default
        // to light. Applied immediately so the first paint is already correct.
        try { IsDarkTheme = await JS.InvokeAsync<bool>("theme.initTheme"); }
        catch { IsDarkTheme = false; }

        _timer = new System.Threading.Timer(async _ =>
        {
            if (_disposed) return;
            try
            {
                _now = DateTime.Now;
                await InvokeAsync(StateHasChanged);
            }
            catch
            {
                // Disposed or circuit disconnected
            }
        }, null, 0, 1000);
    }

    private async Task LoadDataAsync()
    {
        try
        {
            AllDevices = await Api.GetDevicesAsync();
            AllTanks = await Api.GetTanksAsync();
            RecentIncidents = await Api.GetAlertIncidentsAsync(10);
        }
        catch { }
    }

    private void ToggleUserMenu() => IsUserMenuOpen = !IsUserMenuOpen;
    private void ToggleAlertsMenu() => IsAlertsOpen = !IsAlertsOpen;

    private async Task CloseUserMenuDelayed()
    {
        await Task.Delay(200);
        IsUserMenuOpen = false;
        StateHasChanged();
    }

    private async Task CloseAlertsDelayed()
    {
        await Task.Delay(200);
        IsAlertsOpen = false;
        StateHasChanged();
    }

    private async Task CloseSearchDelayed()
    {
        await Task.Delay(250);
        IsSearchOpen = false;
        StateHasChanged();
    }

    private void ClearSearch()
    {
        SearchQuery = "";
        IsSearchOpen = false;
    }

    private void HandleSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(SearchQuery))
        {
            IsSearchOpen = false;
            Nav.NavigateTo($"/devices?search={Uri.EscapeDataString(SearchQuery)}");
        }
    }

    private void NavigateToDevice(string externalId)
    {
        IsSearchOpen = false;
        SearchQuery = "";
        Nav.NavigateTo($"/devices?search={Uri.EscapeDataString(externalId)}");
    }

    public void Dispose()
    {
        _disposed = true;
        _timer?.Dispose();
        _timer = null;
    }

    private async Task ToggleThemeAsync()
    {
        IsDarkTheme = !IsDarkTheme;
        try { await JS.InvokeVoidAsync("theme.setTheme", IsDarkTheme); }
        catch { }
        StateHasChanged();
    }
}
