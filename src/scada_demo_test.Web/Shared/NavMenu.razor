@using Microsoft.AspNetCore.Components.Authorization
@using scada_demo_test.Domain.Constants
@inject AuthenticationStateProvider AuthProvider

<aside class="sidebar @(IsCollapsed ? "collapsed" : "") @(IsMobileOpen ? "mobile-open" : "")">
    <div class="sidebar-brand">
        <img class="brand-logo" src="/images/logo.jpg" alt="ALAM IOT logo" />
        <div class="brand-text">
            <div class="brand-title">ALAM IOT</div>
            <div class="brand-sub">SCADA ENTERPRISE</div>
        </div>
    </div>

    <nav class="sidebar-nav">
        @foreach (var entry in VisibleNavEntries)
        {
            @if (entry is NavItem item)
            {
                <NavLink class="nav-item" href="@item.Href" Match="@item.Match" title="@item.Label">
                    <span class="nav-icon">
                        @GetNavIcon(item.Icon)
                    </span>
                    <span class="nav-label">@item.Label</span>
                </NavLink>
            }
            else if (entry is NavGroup group)
            {
                var groupOpen = OpenGroups.Contains(group.Title);
                <div class="nav-group">
                    <a class="nav-item nav-group-title @(groupOpen ? "group-open" : "")" @onclick="() => ToggleGroup(group.Title)">
                        <span class="nav-icon">
                            @GetNavIcon(group.Icon)
                        </span>
                        <span class="nav-label">@group.Title</span>
                        <span class="nav-caret" style="@(groupOpen ? "transform:rotate(90deg);" : "")">▶</span>
                    </a>
                    @if (groupOpen)
                    {
                        <div class="nav-group-children">
                            @foreach (var child in group.Children)
                            {
                                <NavLink class="nav-item nav-child" href="@child.Href" Match="@child.Match" title="@child.Label">
                                    <span class="nav-icon">
                                        @GetNavIcon(child.Icon)
                                    </span>
                                    <span class="nav-label">@child.Label</span>
                                </NavLink>
                            }
                        </div>
                    }
                </div>
            }
        }
    </nav>

    <div class="sidebar-footer-slot">
        <a class="nav-item logout" href="/account/logout" title="Logout">
            <span class="nav-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
            </span>
            <span class="nav-label">Sign Out</span>
        </a>
    </div>
</aside>

@if (IsMobileOpen)
{
    <div class="sidebar-backdrop" @onclick="OnBackdropClick"></div>
}

@code {
    [Parameter] public bool IsCollapsed { get; set; }
    [Parameter] public bool IsMobileOpen { get; set; }
    [Parameter] public EventCallback OnBackdropClick { get; set; }

    private record NavItem(string Href, string Label, string Icon, Microsoft.AspNetCore.Components.Routing.NavLinkMatch Match, string TabKey);
    private record NavGroup(string Title, string Icon, string TabKey, List<NavItem> Children);

    private readonly HashSet<string> OpenGroups = new() { };

    private readonly List<object> AllNavEntries = new()
    {
        new NavItem("/dashboard", "Dashboard", "EnergyIcon", Microsoft.AspNetCore.Components.Routing.NavLinkMatch.Prefix, AppTabs.Energy),
        new NavItem("/", "Live Monitoring", "MonitoringIcon", Microsoft.AspNetCore.Components.Routing.NavLinkMatch.All, AppTabs.Monitoring),
        new NavItem("/summary", "Totalizer Summary", "SummaryIcon", Microsoft.AspNetCore.Components.Routing.NavLinkMatch.Prefix, AppTabs.Summary),
        new NavGroup("TREND", "TrendsIcon", AppTabs.Charts, new()
        {
            new("/energy", "Plant Energy", "EnergyIcon", Microsoft.AspNetCore.Components.Routing.NavLinkMatch.Prefix, AppTabs.Energy),
            new("/charts", "Charts & Trends", "ChartsIcon", Microsoft.AspNetCore.Components.Routing.NavLinkMatch.Prefix, AppTabs.Charts),
            new("/tanks", "Storage Tanks", "TanksIcon", Microsoft.AspNetCore.Components.Routing.NavLinkMatch.Prefix, AppTabs.Tanks),
        }),
        new NavGroup(AppTabs.Devices, "DevicesIcon", AppTabs.Devices, new()
        {
            new("/devices", "Norvi", "DevicesIcon", Microsoft.AspNetCore.Components.Routing.NavLinkMatch.Prefix, AppTabs.Devices),
            new("/gateway", "Gateway", "GatewayIcon", Microsoft.AspNetCore.Components.Routing.NavLinkMatch.Prefix, AppTabs.Gateway),
        }),
        new NavItem("/reports", "Reports & Export", "ReportsIcon", Microsoft.AspNetCore.Components.Routing.NavLinkMatch.Prefix, AppTabs.Reports),
        new NavItem("/alerts", "Alerts & Events", "AlertsIcon", Microsoft.AspNetCore.Components.Routing.NavLinkMatch.Prefix, AppTabs.Alerts),
        new NavItem("/multi-site", "Multi-Site Plants", "MultiSiteIcon", Microsoft.AspNetCore.Components.Routing.NavLinkMatch.Prefix, AppTabs.MultiSite),
        new NavItem("/audit-logs", "Audit Logs", "AuditLogsIcon", Microsoft.AspNetCore.Components.Routing.NavLinkMatch.Prefix, AppTabs.AuditLogs),
        new NavItem("/users", "Users & Roles", "UsersIcon", Microsoft.AspNetCore.Components.Routing.NavLinkMatch.Prefix, AppTabs.Users),
    };

    private List<object> VisibleNavEntries = new();

    private void ToggleGroup(string key)
    {
        if (!OpenGroups.Remove(key))
        {
            OpenGroups.Add(key);
        }
    }

